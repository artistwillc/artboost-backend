# ArtBoost AI EAS upload filter - V13.12
# Keep actual Expo application source/assets; exclude local development/build debris.

# dependencies / package-manager caches
node_modules/
**/node_modules/
.npm/
.yarn/
.pnpm-store/

# Expo / Metro / tooling caches
.expo/
.expo-shared/
.metro-cache/
.cache/
.parcel-cache/
.turbo/
.nx/
.tmp/
tmp/
temp/

# generated native/build output
/ios
/android
dist/
web-build/
build/
android/.gradle/
android/build/
android/app/build/
ios/build/
ios/DerivedData/
ios/Pods/

# test / reports / coverage
coverage/
.nyc_output/
reports/
test-results/
playwright-report/

# local editor / OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# secrets/local env
.env
.env.*
!.env.example

# signing / local credentials
*.jks
*.keystore
*.p8
*.p12
*.pem
*.key
*.mobileprovision

# logs / temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.bak
*.backup
*.orig
*.orig.*
*.tsbuildinfo

# ArtBoost installer/repair/audit debris
.artboost-*
_artboost_backups/
backups/
backup/
build-backups/
build-handoff/
build-logs/
repair-backups/
rollback/
runtime-regression-*/
launch-regression-*/
pre-browserstack-validation-*/
artboost-source-collector/
artboost-analytics-source-collector/

# source snapshots / installers / archives should never be sent to EAS
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.apk
*.aab
*.ipa
*.xcarchive

# local diagnostic/export artifacts
*.dump
*.dmp
*.trace
*.har
android/
android/**
ios/
ios/**
.artboost-android-launch-audit/
.artboost-ios-launch-audit/
